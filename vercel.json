{
  "buildCommand": "pnpm --filter @workspace/clark-kent run build",
  "outputDirectory": "artifacts/clark-kent/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}